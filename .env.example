# OpenRouter API key for LLM chat functionality (optional if LLM_MOCK=true)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data
# If not set, the built-in geometric Brownian motion simulator is used
MASSIVE_API_KEY=

# Optional: Set to "true" for deterministic mock LLM responses (testing and local dev)
LLM_MOCK=false
